    <script>
        let selectedTemplate = null;

        function selectTemplate(card, templateType) {
            // Remove previous selection
            document.querySelectorAll('.template-card').forEach(c => {
                c.classList.remove('selected');
            });
            
            // Add selection to clicked card
            card.classList.add('selected');
            selectedTemplate = templateType;
            
            // Enable continue button
            document.getElementById('continueBtn').disabled = false;
            
            // Add a little celebration animation
            card.style.transform = 'translateY(-5px) scale(1.02)';
            setTimeout(() => {
                card.style.transform = 'translateY(-5px)';
            }, 200);
        }

        function continueToNext() {
            if (selectedTemplate) {
                // Update progress bar
                document.querySelector('.progress-bar').style.width = '66.66%';
                
                // Update step indicator
                document.querySelectorAll('.step')[0].classList.add('completed');
                document.querySelectorAll('.step')[0].classList.remove('active');
                document.querySelectorAll('.step')[1].classList.add('active');
                
                alert(`Great choice! You selected the ${selectedTemplate} template. Next we'll help you set up your categories and amounts.`);
            }
        }

        function goBack() {
            alert('Going back to financial assessment...');
        }

        // Add some interactive hover effects
        document.querySelectorAll('.template-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                if (!this.classList.contains('selected')) {
                    this.style.transform = 'translateY(-5px)';
                }
            });
            
            card.addEventListener('mouseleave', function() {
                if (!this.classList.contains('selected')) {
                    this.style.transform = 'translateY(0)';
                }
            });
        });
    </script>
